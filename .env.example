# Application
ENVIRONMENT=development
PORT=8000
DEBUG=True

# Database Configuration (SQLite default for local development, PostgreSQL for production)
DATABASE_URL="sqlite+aiosqlite:///./coach_flow.db"
# Production PostgreSQL example:
# DATABASE_URL="postgresql+asyncpg://coachflow:coachflow_secret@localhost:5432/coachflow_db"

# Meta WhatsApp Cloud API
META_WA_PHONE_NUMBER_ID=your_phone_number_id
META_WA_ACCESS_TOKEN=your_meta_system_user_token
META_WA_VERIFY_TOKEN=your_custom_webhook_verify_token
META_WA_APP_SECRET=your_app_secret_for_signature_validation

# Personal Trainer Config
PT_NAME="Coach"
PT_PHONE_NUMBER="+393000000000"
CALENDAR_PROVIDER="google" # google | calcom | apple

# Google Calendar (if using google)
GOOGLE_SERVICE_ACCOUNT_JSON_PATH="credentials/google_service_account.json"
GOOGLE_CALENDAR_ID="primary"

# AI Provider
AI_PROVIDER="openai" # openai | gemini
OPENAI_API_KEY=""
GEMINI_API_KEY=""
AI_MODEL_NAME="gpt-4o-mini"
